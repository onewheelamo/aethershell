pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Hyprland

// ════════════════════════════════════════════════════════════════════════════
// THEME & GLOBAL STATE SINGLETON (Theme.qml)
// ════════════════════════════════════════════════════════════════════════════
// Central reactive store for the entire Quickshell desktop environment:
//   • Watches and auto-reloads core/style_vars.json (generated by Matugen)
//   • Exposes global design tokens (palette, corner radii, opacities, heights)
//   • Injects dynamic styling live into Hyprland via hyprctl eval (borders, blur, rounding)
//   • Manages cross-island popups (ensuring mutual exclusivity)
//   • Hosts the IPC interface ("shell") for external CLI commands and keybinds
// ════════════════════════════════════════════════════════════════════════════

QtObject {
    id: root

    // ────────────────────────────────────────────────────────────────────────
    // SECTION 1: GLOBAL STYLE & ONBOARDING VARIABLES
    // ────────────────────────────────────────────────────────────────────────
    property string activeTheme: "dynamic"
    // Clés de `palette` dans style_vars.json, dans l'ordre du fichier, et leur
    // étiquette lisible quand elle est connue (thèmes importés de KDE).
    property var paletteNoms: []
    property var paletteEtiquettes: ({})

    // Relit style_vars.json : après un import de thèmes, ou un réglage écrit
    // par un service Python.
    function relireStyle() {
        styleFile.reload()
    }
    property int globalRadius: 2
    // Arrondis des sélecteurs de fichiers/dossiers : 0 = suit globalRadius
    property int selecteurRadius: 0
    // Opacité des fenêtres (Hyprland) : decoration.active_opacity / inactive_opacity
    property real globalOpacity: 0.85
    // Opacité des surfaces Quickshell (barre, OSD, panneau, popups)
    property real shellOpacity: 0.7
    property string kbLayout: "fr"
    property bool firstRunCompleted: true
    property bool showKeyboardOnboarding: false
    property bool showConfigButton: true
    property int barHeight: 40
    // Bordure de la barre du haut (capsule fusionnée et îlots) : réglable.
    property bool barBorder: true
    // ── Visualiseur audio (style_vars) ──────────────────────────────────────
    // Réglages de capture et de dessin ; l'applet choisit son rendu (onde ou
    // barres) dans sa propre option, ces valeurs-ci valent pour les deux.
    property int vizFps: 30
    property int vizCols: 96
    property real vizSensibilite: 1.0
    property real vizLissage: 0.2
    property real vizEpaisseur: 1.4
    property string vizCouleur: "accent"
    readonly property color vizColor: vizCouleur === "accentMuted" ? accentMuted
                                     : vizCouleur === "fg" ? fg
                                     : vizCouleur === "warn" ? warn
                                     : vizCouleur === "success" ? success
                                     : accent

    // Espaces entre les îlots de la barre du haut : transparents au lieu d'être
    // peints comme le reste de la capsule. Transparent ne veut pas dire flouté :
    // l'alpha 0 passe sous le seuil `ignore_alpha` de la règle de flou de
    // general.lua, donc le fond d'écran s'y voit net. Les deux vides gardent
    // leur géométrie (main.qml les expose en slotGauche / slotDroit) pour y
    // poser une animation de lecture média.
    property bool barGapsTransparent: false
    // Cadenas des widgets de bureau (style_vars.json : widgets_locked). Vrai =
    // le bind de placement ne prend plus, pour ne pas déplacer un widget d'un
    // SUPER + SHIFT + clic donné par erreur.
    property bool widgetsLocked: false
    // Position de la capsule du lanceur : six emplacements prédéfinis (§3.5 de
    // PROPOSITION_widgets.md), pas une position libre. Les marges sont calculées
    // dans main.qml à partir de cette clé et de la largeur de la capsule.
    property string launcherPosition: "bas-centre"
    // Widgets de bureau (core/widgets.json) : liste de dicts
    // { id, type, workspace, x, y, enabled, options }. main.qml en fait une
    // surface par entrée.
    property var widgets: []
    property string primaryMonitor: ""
    property string wallpaperDir: "$HOME/Images/wallpapers/"
    property string screenshotsDir: "$HOME/Images/Screenshots/"

    // ────────────────────────────────────────────────────────────────────────
    // SECTION 1B: DESIGN TOKENS (TYPOGRAPHIE, RYTHME, ICÔNES)
    // ────────────────────────────────────────────────────────────────────────
    // Une seule échelle typographique : les îles et le panneau ne doivent plus
    // utiliser de pixelSize littéral.
    readonly property string fontUi: "Inter"
    readonly property string fontIcon: "0xProto Nerd Font"

    readonly property int text2xs: 9   // exposants, unités
    readonly property int textXs: 11   // métadonnées, unités
    readonly property int textSm: 12   // corps
    readonly property int textMd: 13   // emphase, libellés de section
    readonly property int textLg: 14   // horloge compacte, titres d'île
    readonly property int textXl: 18   // heure principale
    readonly property int textXxl: 22  // OSD, grands chiffres

    readonly property int iconSm: 14
    readonly property int iconMd: 16
    readonly property int iconLg: 22

    // Widgets de bureau : échelle à part, la barre n'a rien au-dessus de 22 px.
    readonly property int widgetClock: 64    // heure d'un widget d'horloge
    readonly property int widgetClockSm: 30  // secondes, à la même ligne de base
    readonly property int widgetDate: 26     // date seule sur le bureau
    readonly property int widgetTemp: 34     // température d'un widget météo
    readonly property int widgetLabel: 15    // condition + ville sous la température
    readonly property int widgetWeatherIcon: 28
    readonly property int widgetComboDate: 18    // date dans le combo (sous l'heure)
    readonly property int widgetComboWeather: 22 // température dans le combo

    // Rythme : multiples de 4, gouttière d'écran = 8
    readonly property int space1: 4
    readonly property int space2: 8
    readonly property int space3: 12
    readonly property int space4: 16
    readonly property int padH: 12     // padding horizontal interne d'une île
    readonly property int gutter: 8    // marge entre les îles et les bords
    // Largeur d'une barre latérale. Égale à la hauteur de barre par défaut, donc
    // une bande aussi fine que la barre est haute. C'est **le** réglage à
    // augmenter pour caser un peu plus de texte dans une colonne : `bar_extra`,
    // le rendu vertical des applets et la largeur des valeurs le lisent tous ici.
    // Rendre la valeur persistante (style_vars + panneau) reste à faire.
    // Écart entre un applet et son panneau. Mesuré : l'ancre place le popup
    // ~14 px sous l'item, et `anchor.rect.y` est ignoré par Quickshell 0.3.2 —
    // seule `anchor.margins.top` agit. -12 fait toucher la barre.
    readonly property int popupGap: -12

    readonly property int barSideWidth: barHeight
    readonly property int pillRadius: Math.min(globalRadius, Math.round(barHeight / 2))

    // 5a "capsule continue" : les trois pilules fusionnent en une seule surface.
    // Passer à false remet la barre à trois îlots indépendants.
    readonly property bool barMerged: true

    // 6 : le workspace actif est un contour dégradé plutôt qu'un bloc plein.
    // QML ne sait pas dégrader une bordure : le contour est tracé au Canvas dans
    // island_left.qml. Repli automatique sur le fond plein quand le contraste
    // accent/surface est trop faible (fond clair), faute de quoi le liseré
    // disparaîtrait. Mettre wsActiveOutline: false force le fond plein.
    readonly property real accentContrast: {
        const la = 0.2126 * accent.r + 0.7152 * accent.g + 0.0722 * accent.b
        const lb = 0.2126 * surface.r + 0.7152 * surface.g + 0.0722 * surface.b
        return (la > lb) ? (la + 0.05) / (lb + 0.05) : (lb + 0.05) / (la + 0.05)
    }
    readonly property bool wsActiveOutline: accentContrast >= 3.0

    // ────────────────────────────────────────────────────────────────────────
    // SECTION 2: HYPRLAND LAYOUT & BLUR METRICS
    // ────────────────────────────────────────────────────────────────────────
    // Synchronized with hyprland.lua / general.lua and live-updated
    property int gapsIn: 2
    property int gapsOut: 8
    property int borderSize: 2
    property int hyprRounding: 2

    // Blur settings (applied to Hyprland windows + quickshell surfaces)
    property bool blurEnabled: true
    property int blurSize: 3
    property int blurPasses: 3
    property real blurVibrancy: 0.1696
    // Nom de la variante (`decoration:blur:variant`) : kawase, frost, ripple,
    // drops, water, fluid_jar, prism, heat_shimmer, acrylic, aurora, haze.
    // style_vars.json fait foi ; general.lua ne porte que le défaut d'une
    // machine neuve.
    property string blurVariant: "acrylic"

    // ────────────────────────────────────────────────────────────────────────
    // SECTION 3: PALETTE COLORS & TRANSLUCENT SURFACES
    // ────────────────────────────────────────────────────────────────────────
    // Active palette colors (Matugen dynamic or presets)
    property color bg: "#1e1e2e"
    property color fg: "#cdd6f4"
    property color accent: "#b4befe"
    property color accentMuted: "#89b4fa"
    property color surface: "#313244"
    property color surfaceVariant: "#45475a"
    property color error: "#f38ba8"
    property color warn: "#fab387"
    property color info: "#89b4fa"
    property color success: "#a6e3a1"

    // Pre-computed translucent surfaces matching shellOpacity (surfaces Quickshell)
    readonly property color surfaceBg: Qt.alpha(surface, shellOpacity)
    readonly property color surfaceVariantBg: Qt.alpha(surfaceVariant, Math.min(1.0, shellOpacity + 0.08))
    readonly property color panelBg: Qt.alpha(bg, shellOpacity)
    // Verre dépoli autonome (FlouFond.qml) : 0 = éteint. Au-dessus de ~0,7
    // d'opacité il ne sert à rien — Hyprland floute déjà derrière la couche et
    // laisser voir les fenêtres est voulu. En dessous, il rend le texte lisible
    // sans dépendre de la passe de flou du compositeur.
    property real shellFlouInterne: 0.0
    // Fond de bureau en profondeur (FondProfondeur.qml) : parallaxe des calques
    // au changement de bureau. Faux par défaut, le fond d'écran du démon reste
    // intact tant qu'on ne l'allume pas.
    property bool depthWallpaper: false
    // Masque de premier plan (CalqueProfondeur.qml) : les widgets de bureau
    // passent derrière les objets proches du fond. Seuil et adoucissement sont
    // ceux du plugin Noctalia, exposés tels quels (0-100 et 0-50).
    // Localisation de l'utilisateur : un seul jeu de clés pour tout ce qui a
    // besoin de savoir où l'on est (météo, horloge, calendrier, widgets).
    // Effet d'accordéon du panneau de réglages : un seul tiroir ouvert par onglet.
    property bool panelAccordion: true

    property string userLocationVille: ""
    property real userLocationLat: 0
    property real userLocationLon: 0
    property string userLocationTz: ""
    property bool userLocationSet: false

    property bool depthMask: false
    // Rendu du masque quand il est actif : `false` = un calque plein écran
    // (une copie du fond, peu coûteuse) ; `true` = un MultiEffect par widget de
    // bureau, qui découpe le widget lui-même — plus juste, plus cher.
    //
    // EN ATTENTE : le rendu par widget n'était pas juste (alignement et sens du
    // masque à reprendre). Aucune bascule dans le panneau ; la clé se pose à la
    // main dans style_vars.json pour reprendre le travail. Le code est conservé
    // comme base : `layer.effect` dans main.qml, masque publié par
    // CalqueProfondeur.qml, clé acceptée par config_manager.py.
    property bool widgetsMultieffect: false
    // Chemin du masque courant, publié par CalqueProfondeur.qml : les widgets le
    // lisent pour le MultiEffect, et n'ont donc pas à relancer l'inférence.
    property string depthMaskPath: ""
    property int depthMaskSeuil: 30
    property int depthMaskAdouci: 8

    // ────────────────────────────────────────────────────────────────────────
    // SECTION 4: OSD (ON-SCREEN DISPLAY) STATE & CONTROLLER
    // ────────────────────────────────────────────────────────────────────────
    property bool osdVisible: false
    property string osdKind: ""     // "volume" | "brightness" | "mute"
    property real osdValue: 0       // 0..100
    property Timer osdTimer: Timer {
        interval: 1600
        repeat: false
        onTriggered: root.osdVisible = false
    }
    function showOsd(kind, value) {
        root.osdKind = kind
        root.osdValue = Math.max(0, Math.min(100, value))
        root.osdVisible = true
        root.osdTimer.restart()
    }

    // ────────────────────────────────────────────────────────────────────────
    // SECTION 5: POPUP COORDINATION ACROSS ISLANDS
    // ────────────────────────────────────────────────────────────────────────
    // Guarantees only one popup is open at a time across all three islands
    // Historique des lancements de la pilule (désactivé par défaut).
    property bool launchHistory: false

    // Barres supplémentaires : bas, côté gauche, côté droit. Éteintes par défaut ;
    // une barre allumée mais sans applet reste invisible (voir bar_extra.qml).
    property bool barBottomVisible: false
    property bool barLeftVisible: false
    property bool barRightVisible: false

    property bool configPanelVisible: false
    // Vrai quand une action privilégiée (polkit) ou un dialogue externe est actif :
    // le panneau cède la saisie clavier pour que l'invite polkit reçoive directement le focus.
    property bool configPanelYieldFocus: false
    onConfigPanelVisibleChanged: {
        if (!configPanelVisible) configPanelYieldFocus = false
    }
    // Fenêtre de peinture du masque de parallaxe (bouton du panneau).
    property bool masqueParallaxeVisible: false
    // Incrémenté quand un jeu de calques est regénéré : les surfaces qui les
    // affichent relisent leurs images au lieu de garder les anciennes.
    property int calquesVersion: 0
    // Écran des raccourcis (SUPER + K) : surface fixe, centrée, comme le panneau.
    property bool cheatsheetVisible: false
    // Barre de capture (SUPER + SHIFT + S) : pastille verticale à gauche.
    property bool screenshotPickerVisible: false
    property real cheatsheetOpacity: 0.88

    // Pilule spotlight (launcher bas-centre) : surface montée à la demande,
    // fermée par Échap, par un clic hors de la pilule ou après lancement.
    property bool spotlightVisible: false

    // Horodatage de l'ouverture de la pilule. Le fond cliquable ignore les clics
    // des 300 ms qui suivent : sinon le relâchement du clic qui a ouvert la
    // pilule (capsule au repos) atterrit sur le fond et la referme aussitôt.
    property double spotlightOpenedAt: 0
    onSpotlightVisibleChanged: {
        if (spotlightVisible) spotlightOpenedAt = Date.now()
    }
    // Compte des notifications en cours : publié par l'îlot droit (qui possède
    // le serveur) pour que l'applet de la cloche puisse l'afficher.
    property int notifCount: 0
    // Clés des panneaux : celles des îlots ("calendar", "media", "notifications")
    // et celles des applets ("applet:<id>", rendues par le composant lui-même).
    property string activePopup: ""
    // Clic milieu sur un applet : nom de la section du panneau à déplier.
    // Consommé (et remis à vide) par config_panel.qml à l'ouverture.
    property string configTarget: ""

    // Applications dont les notifications n'apparaissent pas en toast (elles vont
    // directement au centre). Alimentée par core/style_vars.json.
    property var quietNotifApps: []
    // « Ne pas déranger » : les notifications continuent d'arriver dans
    // l'historique, mais aucun toast ne s'affiche. Réglé depuis le centre de
    // notifications, mémorisé dans style_vars.json (do_not_disturb).
    property bool doNotDisturb: false
    // Pont vers le centre de notifications : l'îlot droit possède le serveur, la
    // liste et les actions ; l'applet possède le panneau (pour s'ancrer à la
    // cloche). Ces trois propriétés sont la seule surface d'échange.
    property var notifList: []
    property var notifArchive: []
    property var notifOps: ({})

    // Ouvre le panneau de configuration sur une section précise. Le clic milieu
    // d'un applet passe par ici (`Theme.openConfigSection`), comme l'IPC : une
    // définition qui ne vivait que dans le gestionnaire IPC laissait le clic
    // appeler une propriété inexistante — rien ne se passait, et le journal
    // n'en gardait qu'une TypeError.
    // Compteur de demandes : ouvrir la même section deux fois de suite ne change
    // pas `configPanelVisible`, donc le panneau ne verrait rien. Le compteur émet
    // à chaque appel, panneau déjà ouvert compris.
    property int configRequest: 0
    function openConfigSection(section) {
        configTarget = String(section || "")
        // L'état d'abord, le compteur ensuite : le panneau teste la visibilité
        // dans son gestionnaire, et l'incrément qui suit garantit l'émission.
        configPanelVisible = true
        configRequest = configRequest + 1
    }

    // Fenêtres à faire tenir par un `HyprlandFocusGrab` de popup : celle du popup
    // **et** celle de la barre. Sans la barre, Hyprland lève le grab au premier
    // clic et avale ce clic : cliquer un autre bureau fermait le panneau sans
    // changer de bureau, et cliquer un autre applet ne faisait rien. La règle
    // vivait recopiée dans cinq fichiers ; elle vit ici.
    function fenetresGrab(fenetrePopup, ancre) {
        const l = fenetrePopup ? [fenetrePopup] : []
        const w = (ancre && ancre.QsWindow) ? ancre.QsWindow.window : null
        if (w && l.indexOf(w) < 0) l.push(w)
        return l
    }

    function togglePopup(name) {
        activePopup = (activePopup === name) ? "" : name
    }

    // ── Ancrage d'un popup sur son applet ─────────────────────────────────────
    // Un popup ne s'ouvre pas toujours vers le bas : c'est la barre qui porte
    // l'applet qui décide du côté. `ile` s'écrit « barre:place » — `haut:fin`,
    // `bas:milieu`, `cote-gauche:debut` — donc la barre est le premier segment.
    //
    // `alignement` ne sert que sur une barre horizontale : « gauche » met le bord
    // gauche du popup sur celui de l'applet, « centre » ou « droite » font ce
    // qu'on attend. Sur les côtés, le popup s'ouvre **à côté** de l'applet,
    // centré verticalement sur lui ; l'alignement est alors ignoré.
    //
    // `PopupAdjustment.All` reste le filet de sécurité si le résultat sort de
    // l'écran : Quickshell le retourne ou le fait glisser.
    function ancrePopupX(ile, item, popupW, alignement) {
        const barre = String(ile || "").split(":")[0]
        // `barSideWidth`, pas `barHeight` : les deux valent la même chose
        // aujourd'hui, mais élargir la barre latérale décalerait ce popup de la
        // différence et il chevaucherait la bande.
        if (barre === "cote-gauche") return barSideWidth + 6
        if (barre === "cote-droite") return -(popupW + 6)
        const largeur = item ? item.width : 0
        if (alignement === "droite") return Math.round(largeur - popupW)
        if (alignement === "centre") return Math.round((largeur - popupW) / 2)
        return 0
    }

    function ancrePopupY(ile, item, popupH) {
        const barre = String(ile || "").split(":")[0]
        if (barre === "bas") return -(popupH + 6)
        if (barre === "cote-gauche" || barre === "cote-droite")
            return -Math.round((popupH - (item ? item.height : 0)) / 2)
        // Les popups d'applet se posent sous la barre, au niveau du centre de
        // notifications : `barHeight + 6` laissait un vide de treize pixels entre
        // le bas de l'îlot et le panneau, et tous les popups paraissaient « trop
        // bas » par rapport au centre.
        // Les popups d'applet se posent 6 px sous la barre. La marge est un seul
        // point pour toutes les surfaces : la changer les déplace toutes ensemble.
        return barHeight + 6
    }

    // ── Barre : un seul état ──────────────────────────────────────────────────
    // La barre reste en permanence à l'opacité des surfaces du shell (0.65),
    // donc au-dessus du seuil `ignore_alpha` de la règle de flou (0.30) : elle
    // est toujours floutée. Contrairement à la capsule de repos du lanceur, il
    // n'y a ici ni état de veille ni réveil au clic.
    readonly property real barOpacity: shellOpacity
    // La barre ne pose pas sa couleur de thème sur le fond : un noir neutre
    // assombrit sans décaler la teinte, donc les couleurs restent celles du
    // fond quel qu'il soit. La teinte `surface` reste pour les panneaux, où
    // l'opacité est bien plus élevée.
    readonly property color barBg: Qt.alpha("#000000", barOpacity)

    // ── Lanceur au repos ──────────────────────────────────────────────────────
    // La pilule reste posée en bas au centre, en veille à 0.2 (donc sans flou :
    // sous ignore_alpha 0.30). Elle ne prend l'opacité des surfaces Quickshell
    // (et le flou) qu'à l'état de frappe, ouverte par SUPER + R ou par un clic.
    property real spotlightRestOpacity: 0.2
    readonly property color spotlightRestBg: Qt.alpha(surface, spotlightRestOpacity)

    // ────────────────────────────────────────────────────────────────────────
    // SECTION 6: LIVE HYPRLAND LOOK INJECTION (hyprctl eval)
    // ────────────────────────────────────────────────────────────────────────
    function _toHex2(v) {
        const h = Math.round(Math.max(0, Math.min(1, v)) * 255).toString(16)
        return h.length < 2 ? "0" + h : h
    }

    function _toHyprRgba(c, alpha) {
        return "rgba(" + _toHex2(c.r) + _toHex2(c.g) + _toHex2(c.b) + _toHex2(alpha) + ")"
    }

    // Live injection of Matugen / style_vars.json colors and radii into Hyprland
    function syncHyprlandLook() {
        const activeCol = _toHyprRgba(root.accent, 0.93)
        const inactiveCol = _toHyprRgba(root.surfaceVariant, 0.67)
        const luaCmd = "hl.config({ "
            + "general = { col = { active_border = \"" + activeCol + "\", inactive_border = \"" + inactiveCol + "\" } }, "
            + "decoration = { rounding = " + root.hyprRounding + ", active_opacity = " + root.globalOpacity + ", inactive_opacity = " + root.globalOpacity + ", "
            + "blur = { enabled = " + (root.blurEnabled ? "true" : "false")
            + ", size = " + root.blurSize + ", passes = " + root.blurPasses
            + ", vibrancy = " + root.blurVibrancy
            + ", variant = \"" + root.blurVariant + "\" } } "
            + "})"
        hyprApplyProc.command = ["hyprctl", "eval", luaCmd]
        hyprApplyProc.running = true
    }

    property Process hyprApplyProc: Process {}

    property Timer hyprSyncTimer: Timer {
        interval: 150
        repeat: false
        onTriggered: root.syncHyprlandLook()
    }

    // Re-apply dynamic styling whenever Hyprland reloads its configuration
    property Connections hyprConnections: Connections {
        target: Hyprland
        function onRawEvent(event) {
            if (event.name === "configreloaded") {
                root.hyprSyncTimer.restart()
            }
        }
    }

    // ────────────────────────────────────────────────────────────────────────
    // SECTION 7: FILEVIEW WATCHER (core/style_vars.json)
    // ────────────────────────────────────────────────────────────────────────
    function applyPaletteData(data) {
        if (!data) return
        if (typeof data.active_theme === "string") root.activeTheme = data.active_theme
        if (typeof data.global_radius === "number") root.globalRadius = data.global_radius
        if (typeof data.selecteur_radius === "number") root.selecteurRadius = data.selecteur_radius
        if (typeof data.hypr_rounding === "number") root.hyprRounding = data.hypr_rounding
        if (typeof data.global_opacity === "number") root.globalOpacity = data.global_opacity
        if (typeof data.shell_flou_interne === "number") root.shellFlouInterne = Math.max(0, Math.min(1, data.shell_flou_interne))
        if (typeof data.depth_wallpaper === "boolean") root.depthWallpaper = data.depth_wallpaper
        if (typeof data.panel_accordion === "boolean") root.panelAccordion = data.panel_accordion
        if (typeof data.user_location_ville === "string") root.userLocationVille = data.user_location_ville
        if (typeof data.user_location_tz === "string") root.userLocationTz = data.user_location_tz
        if (typeof data.user_location_lat === "number" && typeof data.user_location_lon === "number") {
            root.userLocationLat = data.user_location_lat
            root.userLocationLon = data.user_location_lon
            root.userLocationSet = true
        } else {
            root.userLocationSet = false
        }
        if (typeof data.depth_mask === "boolean") root.depthMask = data.depth_mask
        if (typeof data.widgets_multieffect === "boolean") root.widgetsMultieffect = data.widgets_multieffect
        if (typeof data.depth_mask_seuil === "number") root.depthMaskSeuil = data.depth_mask_seuil
        if (typeof data.depth_mask_adouci === "number") root.depthMaskAdouci = data.depth_mask_adouci
        if (typeof data.shell_opacity === "number") root.shellOpacity = Math.max(0.2, Math.min(1.0, data.shell_opacity))
        if (typeof data.show_config_button === "boolean") root.showConfigButton = data.show_config_button
        if (typeof data.bar_height === "number" && data.bar_height >= 28 && data.bar_height <= 60) root.barHeight = data.bar_height
        if (typeof data.bar_border === "boolean") root.barBorder = data.bar_border
        if (typeof data.bar_gaps_transparent === "boolean") root.barGapsTransparent = data.bar_gaps_transparent
        if (typeof data.widgets_locked === "boolean") root.widgetsLocked = data.widgets_locked
        if (typeof data.viz_fps === "number") root.vizFps = Math.max(10, Math.min(60, Math.round(data.viz_fps)))
        if (typeof data.viz_cols === "number") root.vizCols = Math.max(16, Math.min(256, Math.round(data.viz_cols)))
        if (typeof data.viz_sensibilite === "number") root.vizSensibilite = Math.max(0.05, Math.min(4.0, data.viz_sensibilite))
        if (typeof data.viz_lissage === "number") root.vizLissage = Math.max(0, Math.min(0.99, data.viz_lissage))
        if (typeof data.viz_epaisseur === "number") root.vizEpaisseur = Math.max(0.5, Math.min(4.0, data.viz_epaisseur))
        if (typeof data.viz_couleur === "string" && data.viz_couleur.length > 0) root.vizCouleur = data.viz_couleur
        if (typeof data.bar_bottom === "boolean") root.barBottomVisible = data.bar_bottom
        if (typeof data.bar_left === "boolean") root.barLeftVisible = data.bar_left
        if (typeof data.bar_right === "boolean") root.barRightVisible = data.bar_right
        if (typeof data.launcher_position === "string" && data.launcher_position.length > 0) root.launcherPosition = data.launcher_position
        if (Array.isArray(data.widgets)) root.widgets = data.widgets
        if (typeof data.cheatsheet_opacity === "number") root.cheatsheetOpacity = Math.max(0.2, Math.min(1.0, data.cheatsheet_opacity))
        if (typeof data.primary_monitor === "string") root.primaryMonitor = data.primary_monitor
        if (typeof data.wallpaper_dir === "string" && data.wallpaper_dir.length > 0) root.wallpaperDir = data.wallpaper_dir
        if (typeof data.screenshots_dir === "string" && data.screenshots_dir.length > 0) root.screenshotsDir = data.screenshots_dir
        if (typeof data.blur_enabled === "boolean") root.blurEnabled = data.blur_enabled
        if (typeof data.blur_size === "number") root.blurSize = Math.max(1, Math.min(20, data.blur_size))
        if (typeof data.blur_passes === "number") root.blurPasses = Math.max(1, Math.min(8, data.blur_passes))
        if (typeof data.blur_vibrancy === "number") root.blurVibrancy = Math.max(0, Math.min(1, data.blur_vibrancy))
        if (typeof data.blur_variant === "string" && data.blur_variant.length > 0) root.blurVariant = data.blur_variant
        if (typeof data.kb_layout === "string") root.kbLayout = data.kb_layout
        if (Array.isArray(data.quiet_notif_apps)) root.quietNotifApps = data.quiet_notif_apps
        if (typeof data.do_not_disturb === "boolean") root.doNotDisturb = data.do_not_disturb
        if (typeof data.launch_history === "boolean") root.launchHistory = data.launch_history
        if (typeof data.first_run_completed === "boolean") {
            root.firstRunCompleted = data.first_run_completed
            if (!data.first_run_completed) {
                root.showKeyboardOnboarding = true
            }
        }

        const palettes = data.palette || {}
        // Noms des palettes disponibles : le panneau les liste au lieu de trois
        // noms écrits en dur, et les schémas KDE importés apparaissent là.
        root.paletteNoms = Object.keys(palettes)
        root.paletteEtiquettes = data.palette_noms || ({})
        const pal = palettes[root.activeTheme] || palettes["dynamic"] || {}

        if (pal.bg) root.bg = pal.bg
        if (pal.fg) root.fg = pal.fg
        if (pal.accent) root.accent = pal.accent
        if (pal.accent_muted) root.accentMuted = pal.accent_muted
        if (pal.surface) root.surface = pal.surface
        if (pal.surface_variant) root.surfaceVariant = pal.surface_variant
        if (pal.error) root.error = pal.error
        if (pal.warn) root.warn = pal.warn
        if (pal.info) root.info = pal.info
        if (pal.success) root.success = pal.success

        root.hyprSyncTimer.restart()
    }

    // Vrai dès qu'une lecture de style_vars.json a réussi : sert à distinguer un
    // échec passager au démarrage d'un fichier vraiment cassé.
    property bool styleRelu: false

    // Déclaré en propriété, comme les autres enfants : le type racine est un
    // Singleton, qui n'a pas de propriété par défaut où poser un enfant nu.
    property Timer relanceStyle: Timer {
        interval: 250
        onTriggered: styleFile.reload()
    }

    property FileView styleFile: FileView {
        path: Quickshell.shellPath("core/style_vars.json")
        watchChanges: true
        printErrors: false
        onFileChanged: reload()
        onLoaded: {
            try {
                const parsed = JSON.parse(text())
                root.applyPaletteData(parsed)
                root.styleRelu = true
            } catch (e) {
                // La lecture tombe parfois au milieu d'une écriture faite par un
                // service Python (import des thèmes, réglage d'applet) : une
                // relecture unique suffit, et on ne crie que si elle échoue aussi.
                if (!root.styleRelu) {
                    relanceStyle.restart()
                    return
                }
                console.warn("Theme.qml: Failed to parse core/style_vars.json:", e)
            }
        }
    }

    // Widgets de bureau : fichier d'état séparé, surveillé comme style_vars.
    // Sans ce FileView, une entrée ajoutée par le panneau n'atteindrait jamais
    // le rendu (le shell ne relit pas les fichiers qu'il ne surveille pas).
    property FileView widgetsFile: FileView {
        path: Quickshell.shellPath("core/widgets.json")
        watchChanges: true
        printErrors: false
        onFileChanged: reload()
        onLoaded: {
            try {
                const parsed = JSON.parse(text())
                root.widgets = Array.isArray(parsed.widgets) ? parsed.widgets : []
            } catch (e) {
                console.warn("Theme.qml: Failed to parse core/widgets.json:", e)
            }
        }
    }

    // ────────────────────────────────────────────────────────────────────────
    // Icônes de remplacement pour les items du systray
    // ────────────────────────────────────────────────────────────────────────
    // Certains items SNI ne publient aucune image (IconPixmap vide, IconName
    // vide) : le shell dessinait alors un pixmap illisible — le rectangle bruité
    // qu'on voyait pour le moniteur de casque. On peut leur associer une icône par
    // leur propriété Id, ici ou avec un chemin absolu.
    property var trayIconMap: ({})

    property FileView trayIconsFile: FileView {
        path: Quickshell.shellPath("core/tray_icons.json")
        watchChanges: true
        printErrors: false
        onFileChanged: reload()
        onLoaded: {
            try {
                const parsed = JSON.parse(text())
                root.trayIconMap = (parsed && typeof parsed === "object") ? parsed : ({})
            } catch (e) {
                root.trayIconMap = ({})
            }
        }
    }

    // Rendu d'URL : chemin absolu tel quel, sinon relatif à assets/tray/.
    // Chaîne vide = pas de correspondance, l'appelant garde l'icône de l'item.
    function trayIconFor(itemId) {
        if (!itemId) return ""
        const entry = (root.trayIconMap || ({}))[itemId]
        if (!entry) return ""
        const value = (typeof entry === "string") ? entry : (entry.icon || "")
        if (!value) return ""
        if (value.charAt(0) === "/")
            return "file://" + value
        return "file://" + Quickshell.shellPath("assets/tray/" + value)
    }

    // ────────────────────────────────────────────────────────────────────────
    // Variables d'application (core/app_vars.json)
    // ────────────────────────────────────────────────────────────────────────
    // Mêmes valeurs que les raccourcis Hyprland (programs.lua), réglables dans
    // l'onglet Applications du panneau. `program("Music")` -> "strawberry".
    property var appVars: ({})

    property FileView appVarsFile: FileView {
        path: Quickshell.shellPath("core/app_vars.json")
        watchChanges: true
        printErrors: false
        onFileChanged: reload()
        onLoaded: {
            try {
                const parsed = JSON.parse(text())
                root.appVars = (parsed && typeof parsed === "object") ? parsed : ({})
            } catch (e) {
                root.appVars = ({})
            }
        }
    }

    function program(name) {
        return (root.appVars && root.appVars[name]) ? String(root.appVars[name]) : ""
    }

    // ────────────────────────────────────────────────────────────────────────
    // SECTION 8: IPC HANDLER ("shell")
    // ────────────────────────────────────────────────────────────────────────
    // Allows scripts, keybindings and sub-processes to control Quickshell:
    //   qs -p /path/to/shell ipc shell toggleConfig
    //   qs -p /path/to/shell ipc shell osd volume 75
    // Crochet : main.qml y branche le mode placement d'un widget. Le déclencheur
    // vient de Hyprland (SUPER + SHIFT + clic), seul endroit où le modificateur est
    // fiable — dans un événement souris QML, `mouse.modifiers` vaut 0.
    property var placeWidgetHook: null
    // Même principe pour le menu d'un widget de bureau : main.qml y branche
    // l'ouverture, l'IPC permet de le piloter sans souris (tests).
    property var widgetMenuHook: null

    // Crochet symétrique pour la capture : main.qml y branche requestCapture,
    // ce qui rend les modes lançables par IPC (tests scriptés).
    property var captureHook: null

    // Tiroir de l'historique des notifications (surface `shell-notif-history`),
    // indépendant du panneau de notifications et de son toast.
    property bool notifHistoryVisible: false

    // Crochets de diagnostic des notifications, branchés par island_right :
    //   quickshell ipc call shell notifTargets     → JSON des cibles résolues
    //   quickshell ipc call shell notifOpenLatest  → ouvre la cible la plus récente
    property var notifTargetsHook: null
    property var notifOpenHook: null
    //   quickshell ipc call shell notifClear        → vide le centre (pas l'historique)
    property var notifClearHook: null

    property IpcHandler ipc: IpcHandler {
        target: "shell"
        function placeWidget() {
            if (root.placeWidgetHook)
                root.placeWidgetHook()
        }
        function openWidgetMenu(id: string) {
            if (root.widgetMenuHook)
                root.widgetMenuHook(id)
        }
        function toggleConfig() {
            root.configPanelVisible = !root.configPanelVisible
        }
        function toggleMasqueParallaxe() {
            root.masqueParallaxeVisible = !root.masqueParallaxeVisible
        }
        // Ouvre le panneau sur une section précise — utilisé par le clic milieu
        // des applets, et par les tests : ipc call shell openConfigSection quickshell_applets
        function openConfigSection(section: string) {
            root.openConfigSection(section)
        }
        function setConfigButtonVisible(visible: bool) {
            root.showConfigButton = visible
        }
        function toggleConfigButton() {
            root.showConfigButton = !root.showConfigButton
        }
        function reloadTheme() {
            root.relireStyle()
        }
        function osd(kind: string, value: real) {
            root.showOsd(kind, value)
        }
        // Permet de piloter les popups pour les tests : ipc call shell togglePopup calendar
        function togglePopup(name: string) {
            root.togglePopup(name)
        }
        function toggleSpotlight() {
            root.spotlightVisible = !root.spotlightVisible
        }
        // Écran des raccourcis (SUPER + K) : show/hide idempotents à côté du
        // toggle, pour les tests scriptés (un toggle qui perd un appel dérive).
        function toggleCheatsheet() {
            root.cheatsheetVisible = !root.cheatsheetVisible
        }
        function showCheatsheet() {
            root.cheatsheetVisible = true
        }
        function hideCheatsheet() {
            root.cheatsheetVisible = false
        }
        function cheatsheetState(): bool {
            return root.cheatsheetVisible
        }
        function showSpotlight() {
            root.spotlightVisible = true
        }
        function hideSpotlight() {
            root.spotlightVisible = false
        }
        function spotlightState(): bool {
            return root.spotlightVisible
        }
        function launchHistoryState(): bool {
            return root.launchHistory
        }
        // Barre de capture : toggle pour le bind SUPER + SHIFT + S (screenshot.sh
        // sans argument), show/hide idempotents pour les tests scriptés.
        function toggleScreenshotPicker() {
            root.screenshotPickerVisible = !root.screenshotPickerVisible
        }
        function showScreenshotPicker() {
            root.screenshotPickerVisible = true
        }
        function hideScreenshotPicker() {
            root.screenshotPickerVisible = false
        }
        function screenshotPickerState(): bool {
            return root.screenshotPickerVisible
        }
        // Lance une capture sans passer par la pastille :
        //   quickshell ipc call shell captureMode record-full
        // Même chemin que les boutons (requestCapture dans main.qml), donc
        // testable au clavier — le clic sur une icône n'ajoute rien à couvrir.
        function captureMode(mode: string) {
            if (root.captureHook)
                root.captureHook(mode)
        }
        // Diagnostic du clic sur le titre d'une notification :
        //   quickshell ipc call shell notifTargets      → cibles résolues (JSON)
        //   quickshell ipc call shell notifOpenLatest   → ouvre la plus récente
        function notifTargets(): string {
            return root.notifTargetsHook ? String(root.notifTargetsHook()) : "[]"
        }
        function notifOpenLatest(): bool {
            return root.notifOpenHook ? Boolean(root.notifOpenHook()) : false
        }
        function notifClear(): bool {
            return root.notifClearHook ? Boolean(root.notifClearHook()) : false
        }
        // Tiroir de l'historique : toggle + show/hide idempotents (mêmes règles
        // que les autres surfaces : un toggle perd un appel, un show non).
        function toggleNotifHistory() {
            root.notifHistoryVisible = !root.notifHistoryVisible
        }
        function showNotifHistory() {
            root.notifHistoryVisible = true
        }
        function hideNotifHistory() {
            root.notifHistoryVisible = false
        }
        function notifHistoryState(): bool {
            return root.notifHistoryVisible
        }
    }
}
