[Unit]
Description=AetherShell (barre, panneaux, widgets)
# Rattaché à la session graphique : arrêté avec elle, relancé avec elle.
PartOf=graphical-session.target
After=graphical-session.target
# Borne de relance : sans elle, un échec toutes les 3 s bouclait indéfiniment
# (194 coredumps en sept jours, compteur de relance monté à 42). Cinq essais en
# 90 s couvrent un démarrage de session normal ; au-delà, l'échec reste au
# journal au lieu de tourner en rond.
StartLimitIntervalSec=90
StartLimitBurst=5

[Service]
Type=simple
# Le lanceur attend le socket Wayland et retrouve la signature Hyprland : sans
# ça, Qt démarre sans platform plugin et abandonne (SIGABRT) à chaque session où
# le compositeur n'est pas encore prêt.
ExecStart=/bin/sh %h/.config/quickshell/core/lancer_quickshell.sh
Restart=on-failure
RestartSec=3
# Qt avorte sur une erreur fatale (platform plugin absent) : sans cette borne,
# chaque abandon laissait un cœur de 1,6 Mo. 332 Mo accumulés en sept jours. Le
# lanceur évite désormais l'abandon ; la borne couvre les autres cas.
LimitCORE=0

[Install]
WantedBy=default.target
