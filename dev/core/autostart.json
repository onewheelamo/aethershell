[
    {
        "name": "Hermes (canal d'approbation)",
        "cmd": "sh -c 'pgrep -f hermes_approbations.py >/dev/null || exec python3 \"$HOME/.config/quickshell/core/hermes_approbations.py\" serveur' &",
        "enabled": true
    },
    {
        "name": "Quickshell (barre)",
        "cmd": "sh -c '/usr/bin/pgrep -x quickshell >/dev/null || exec \"$HOME/.config/quickshell/core/lancer_quickshell.sh\"' &",
        "enabled": true
    },
    {
        "name": "Hypridle (inactivit\u00e9)",
        "cmd": "systemctl --user start hypridle",
        "enabled": true
    },
    {
        "name": "awww-daemon (wallpaper, si Noctalia absent)",
        "cmd": "sh -c '/usr/bin/pgrep -x awww-daemon >/dev/null || exec awww-daemon' &",
        "enabled": true
    },
    {
        "name": "Agent Polkit",
        "cmd": "sh -c '/usr/bin/pgrep -f \"(polkit-kde-authentication-agent-1|hyprpolkitagent|lxqt-policykit-agent)\" >/dev/null && exit 0; for agent in /usr/libexec/kf6/polkit-kde-authentication-agent-1 /usr/lib/polkit-kde-authentication-agent-1 /usr/libexec/polkit-kde-authentication-agent-1 /usr/lib/hyprpolkitagent/hyprpolkitagent /usr/libexec/hyprpolkitagent /usr/libexec/lxqt-policykit-agent /usr/lib/lxqt-policykit-agent; do if [ -x \"$agent\" ]; then exec \"$agent\"; fi; done'",
        "enabled": true
    },
    {
        "name": "Proton VPN",
        "cmd": "protonvpn-app",
        "enabled": true
    },
    {
        "name": "Focus de l'invite polkit",
        "cmd": "sh -c '/usr/bin/pgrep -f core/polkit_focus.py >/dev/null && exit 0; exec python3 ~/.config/quickshell/core/polkit_focus.py'",
        "enabled": true
    },
    {
        "name": "Presse-papiers (veilleurs cliphist)",
        "cmd": "sh -c '$HOME/.config/quickshell/core/cliphist_watch.sh' &",
        "enabled": true
    }
]