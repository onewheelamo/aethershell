# Build and transient files
*.new
*.upstream
*.bak
*.old
*.swp
*.kate-swp
*.verrou
*~

# Python cache & logs
__pycache__/
*.py[cod]
*$py.class
*.log

# Données générées (index des applications de la pilule)
dev/core/app_index.json
dev/core/launch_history.json

# Sorties générées du greeter (conf + fond issus de style_vars.json)
dev/sddm/out/

# Aperçus du greeter : des rendus d'écran qui n'ont pas à peser dans le dépôt ni
# à partir sur GitHub. Sortis le 2026-11-11, historique purgé pour qu'il n'en
# reste aucune trace. Les maquettes (`dev/mockups/`), elles, restent : c'est la
# référence de conception du panneau, de la barre et du greeter.
dev/sddm/preview/

# Maquettes et rendus d'écran (HTML, PNG) : des images de conception, pas du
# code. Sorties du dépôt le 2026-11-11, historique purgé pour qu'il n'en reste
# aucune trace sur GitHub. Elles vivent sur la machine.
dev/mockups/

# Sensitive information
dev/core/secrets.json
secrets.json

# Environment backups
backups_env/

# Third-party inspiration repos (nested git clones)
inspirations/

# caches des services (valeurs relues, jamais des sources)
dev/core/*_cache.json

# Tous les fichiers .md sont ignorés, à l'exception des README et du CHANGELOG
*.md
!README.md
!**/README.md
!CHANGELOG.md

# Scripts de synchronisation entre machines — locaux, jamais dans le dépôt
sync.sh
dev/sync.sh

# Brouillons, propositions et archives de travail. Le répertoire de travail ne
# garde que ce qui sert : les propositions s'écrivent ici et meurent ici.
tmp/
